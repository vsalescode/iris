# Copie este arquivo para ".env". O .env NUNCA deve ser compartilhado nem versionado.
# Depois de mudar algo aqui, reinicie a Iris.
# Ajuste técnico em branco (ou ausente) = usa o valor padrão mostrado.
# Listas: valores separados por vírgula. Sim/não: true/false.

# ============ Chaves de API ============
# Gemini (conversa principal, Live) – https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (reserva, Whisper) – https://console.groq.com/keys
GROQ_API_KEY=

# ============ Servidor e janela ============
IRIS_HOST=127.0.0.1
IRIS_PORTA=8765
IRIS_ABRIR_JANELA=true
# caminho do msedge.exe; vazio = procura sozinho
IRIS_CAMINHO_EDGE=
# pasta de dados (memória, tokens, auditoria); vazio = pasta "dados" da Iris
IRIS_PASTA_DADOS=
# como as datas são escritas para ela (pt_BR, en_US, es_ES...)
IRIS_IDIOMA_DATAS=pt_BR

# ============ Ouvir ============
OUVIR_IDIOMA=pt-BR
OUVIR_PALAVRAS_ATIVACAO=iris,íris,ei iris,hey iris
# silêncio (s) que indica fim da fala com a frase ainda aberta / já fechada (modo reserva)
OUVIR_PAUSA_SEGUNDOS=1.5
OUVIR_PAUSA_FINAL_SEGUNDOS=0.8
# Whisper (Groq) corrige a transcrição no modo reserva
WHISPER_ATIVO=true
WHISPER_MODELO=whisper-large-v3-turbo
WHISPER_ESPERA_SEGUNDOS=6

# ============ Gemini Live (conversa principal) ============
LIVE_ATIVA=true
# o 1º é o principal; os seguintes são reserva
LIVE_MODELOS=gemini-3.1-flash-live-preview,gemini-2.5-flash-native-audio-latest
# voz fixa da Live (ex.: Kore); vazio = usa a voz Gemini escolhida na engrenagem
LIVE_VOZ=
# silêncio (ms) que a Live entende como "terminei de falar"
LIVE_SILENCIO_MS=600
# falar por cima corta a Iris. Se ela se cortar sozinha (ouvindo a própria voz), use false
LIVE_INTERROMPER_FALANDO=true
# pesquisa no Google: a cota grátis atual não inclui; ligar só atrasa a conexão
LIVE_PESQUISA_GOOGLE=false
LIVE_PESQUISA_BLOQUEADA_HORAS=6
LIVE_ESPERA_CONEXAO_SEGUNDOS=8
LIVE_BUFFER_SEGUNDOS=10
LIVE_REENVIO_SEGUNDOS=15
# se a Live falhar, usa o modo reserva por N minutos
LIVE_FALHA_TEMPORARIA_MINUTOS=5

# ============ Cérebro do modo reserva (clássico) ============
# o primeiro é o principal; o seguinte assume se ele falhar
CEREBRO_ORDEM=groq,gemini
GEMINI_MODELO_TEXTO=gemini-3.5-flash-lite
# minimal = responde mais rápido; low/medium = pensa mais antes
GEMINI_PENSAMENTO=minimal
GROQ_MODELO_TEXTO=openai/gpt-oss-120b
# mais alto = mais criativa (e mais chance de inventar)
CEREBRO_TEMPERATURA=0.7
CEREBRO_MAX_HISTORICO=30
CEREBRO_ESPERA_PRIMEIRA_PALAVRA=8
CEREBRO_ESPERA_ENTRE_PEDACOS=20
CEREBRO_DESCANSO_SEGUNDOS=120

# ============ Voz do modo reserva (TTS) ============
# o plano grátis dá ~10 falas/dia POR modelo: ela faz rodízio entre eles
TTS_GEMINI_MODELOS=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts
# instrução de tom enviada junto do texto; vazio (às vezes a voz LÊ a instrução)
TTS_ESTILO=
# voz Edge usada se o Gemini falhar, e a voz Edge mais estável (última tentativa)
VOZ_RESERVA=pt-BR-ThalitaMultilingualNeural
VOZ_EDGE_ESTAVEL=pt-BR-FranciscaNeural
TTS_DESCANSO_SEGUNDOS=180
TTS_ESGOTADO_DIA_HORAS=3
GROQ_TTS_MODELO=canopylabs/orpheus-v1-english

# ============ Memória ============
# quanto da memória vai para as instruções dela em cada conversa
MEMORIA_FATOS_NO_PROMPT=40
MEMORIA_CONVERSAS_NO_PROMPT=4
MEMORIA_ASSUNTOS_NO_PROMPT=15

# ============ Vigília (modo proativo) ============
# ronda em segundo plano: e-mails novos e arquivos novos nas zonas_liberadas do permissoes.yaml
VIGIA_ATIVA=true
VIGIA_INTERVALO_MINUTOS=5
VIGIA_GMAIL=true
VIGIA_GMAIL_BUSCA=in:inbox newer_than:2d
# algo urgente: ela fala sozinha (fora do horário de silêncio e no máximo uma vez a cada N minutos)
VIGIA_FALAR_SOZINHA=true
VIGIA_SILENCIO_NOTURNO=23-7
VIGIA_INTERVALO_ENTRE_FALAS_MINUTOS=20
# triagens com IA por dia (só acontecem quando algo novo aparece)
VIGIA_MAX_IA_POR_DIA=100
VIGIA_PENDENCIAS_NO_PROMPT=8

# ============ Habilidades (SKILL.md) ============
# relativo = a partir da pasta da Iris
HABILIDADES_ATIVAS=habilidades_ativas
HABILIDADES_PROPOSTAS=habilidades_propostas
# tamanho máximo do passo a passo de uma habilidade (caracteres)
HABILIDADES_LIMITE_TEXTO=8000
# melhoria com menos que esta fração do tamanho da versão atual gera alerta (perdeu passos?)
HABILIDADES_ALERTA_ENCOLHIMENTO=0.6

# ============ Personalidade que evolui ============
# Ela PROPÕE mudanças no jeito dela (você aprova na gaveta ou por voz). false = não propõe sozinha
PERSONALIDADE_EVOLUIR=true
# onde fica o que ela aprendeu (relativo = pasta da Iris)
PERSONALIDADE_ARQUIVO=personalidade_aprendida.yaml
PERSONALIDADE_MAX_JEITOS=15
# ajustes criados além dos 6 de base
PERSONALIDADE_MAX_TRACOS=6
# quantos pontos (0-100) um ajuste proposto por ela pode andar de cada vez
PERSONALIDADE_PASSO_MAXIMO=25

# ============ Oficina (programas novos feitos pelo Claude Code) ============
# Usa o SEU plano do Claude (não é grátis). false = ela não encomenda nada
OFICINA_ATIVA=true
OFICINA_PASTA=oficina
# caminho do claude.exe; vazio = procura sozinho
OFICINA_CLAUDE=
# sonnet | opus | haiku (sonnet: bom e gasta menos)
OFICINA_MODELO=sonnet
OFICINA_MAX_TURNOS=60
# passou disso, a encomenda é cancelada
OFICINA_TEMPO_MINUTOS=20
# tempo máximo de cada vez que ela USA um programa pronto (segundos)
OFICINA_PROGRAMA_SEGUNDOS=120

# ============ Ferramentas e e-mail ============
# tempo (s) para você confirmar uma ação ("pode enviar")
CONFIRMACAO_VALIDADE_SEGUNDOS=120
# caracteres de um arquivo enviados à IA / tamanho máximo de arquivo lido (MB)
ARQUIVO_LIMITE_LEITURA=15000
ARQUIVO_LIMITE_TAMANHO_MB=2
# PDFs: tamanho máximo, páginas lidas e se PDF escaneado (só imagem) pode ser lido pelo Gemini
ARQUIVO_PDF_LIMITE_MB=20
ARQUIVO_PDF_MAX_PAGINAS=30
ARQUIVO_PDF_LEITURA_NUVEM=true
# caracteres de um e-mail enviados à IA / e-mails por pedido em lote (o Gmail limita ~50/s)
GMAIL_LIMITE_CORPO=8000
GMAIL_TAMANHO_LOTE=40
# false = ela só lê e-mails (rode o autorizar_gmail.bat de novo para a permissão ficar só de leitura)
GMAIL_PERMITIR_ENVIO=true
# soma máxima dos arquivos anexados a um e-mail, em MB (o Gmail aceita até 25)
GMAIL_ANEXOS_LIMITE_MB=24
# onde ficam o arquivo baixado do Google Cloud e a autorização.
# Caminho relativo = a partir da pasta da Iris (continua valendo se o projeto mudar de lugar).
GMAIL_CREDENCIAIS=dados/gmail_credenciais.json
GMAIL_TOKEN=dados/gmail_token.json
